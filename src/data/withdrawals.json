  "steps": [
    {
      "id": "deel-payoneer",
      "label": "Deel a Payoneer",
      "inputCurrency": "USD",
      "outputCurrency": "USD",
      "fee": { "percent": 1, "min": 12 },
      "feeStatus": "official",
      "minimumAmount": 50,
      "sourceIds": ["deel-fees"],
      "conditions": "Tarifa estándar para este método. Cuenta Payoneer propia y habilitada."
    },
    {
      "id": "payoneer-reception",
      "label": "Recepción en Payoneer",
      "inputCurrency": "USD",
      "outputCurrency": "USD",
      "fee": null,
      "feeStatus": "pending",
      "sourceIds": ["payoneer-pricing"],
      "conditions": "La recepción desde plataformas depende del convenio y la cuenta. Confirmá el cargo adicional o que ya esté incluido en Deel."
    },
    {
      "id": "payoneer-santander",
      "label": "Payoneer a Santander",
      "inputCurrency": "USD",
      "outputCurrency": "USD",
      "fee": { "percent": 3.3 },
      "feeStatus": "official",
      "sourceIds": ["payoneer-ar", "payoneer-pricing"],
      "conditions": "Referencia publicada de punta a punta para esta etapa. Confirmá la tarifa de tu cuenta y banco; no se suman otra vez cargos incluidos."
    },
    {
      "id": "payoneer-bitso",
      "label": "Payoneer a Bitso",
      "inputCurrency": "USD",
      "outputCurrency": "USD",
      "fee": { "percent": 2.9 },
      "feeStatus": "official",
      "sourceIds": ["payoneer-ar", "payoneer-pricing"],
      "conditions": "Tarifa publicada de punta a punta. No dupliques cargos que ya estén incluidos en el precio de cambio."
    },
    {
      "id": "payoneer-prex",
      "label": "Payoneer a Prex",
      "inputCurrency": "USD",
      "outputCurrency": "USD",
      "fee": { "percent": 3.8 },
      "feeStatus": "official",
      "sourceIds": ["payoneer-ar", "payoneer-pricing"],
      "conditions": "Tarifa publicada de punta a punta. El cambio MEP de Prex debe confirmarse en la app."
    },
    {
      "id": "usd-ars",
      "label": "Cambio a pesos",
      "inputCurrency": "USD",
      "outputCurrency": "ARS",
      "fee": { "fixed": 0 },
      "feeStatus": "included-in-rate",
      "sourceIds": ["payoneer-ar"],
      "conditions": "Cotización efectiva después del spread, antes de los cargos de transferencia ya desglosados. Si tu precio ya incluye esos cargos, reemplazalos por cero para no duplicarlos."
    },
    {
      "id": "deel-astropay",
      "label": "Deel a AstroPay",
      "inputCurrency": "USD",
      "outputCurrency": "USD",
      "fee": null,
      "feeStatus": "conflicting",
      "minimumAmount": 5,
      "sourceIds": ["deel-fees", "deel-astropay"],
      "conditions": "Las guías oficiales difieren: 0,75% en el listado más reciente y 1% para igual moneda en la guía anterior. Cargá el costo que te muestra tu cuenta. Requiere saldo de destino en USD habilitado y domicilio coincidente."
    },
    {
      "id": "deel-arq-instant",
      "label": "Deel a ARQ · instantáneo",
      "inputCurrency": "USD",
      "outputCurrency": "USD",
      "fee": { "percent": 0.75 },
      "feeStatus": "official",
      "sourceIds": ["arq-deel"],
      "conditions": "Solo cuentas Deel de Argentina; método ARQtag. Sin beneficios ni promociones."
    },
    {
      "id": "deel-arq-standard",
      "label": "Deel a ARQ · estándar",
      "inputCurrency": "USD",
      "outputCurrency": "USD",
      "fee": { "fixed": 5 },
      "feeStatus": "official",
      "sourceIds": ["arq-deel"],
      "conditions": "Transferencia estándar; los beneficios de tu plan pueden cambiar el costo."
    },
    {
      "id": "usd-usdc-arq",
      "label": "Acreditación en USDc",
      "inputCurrency": "USD",
      "outputCurrency": "USDc",
      "fee": { "fixed": 0 },
      "feeStatus": "included-in-rate",
      "sourceIds": ["arq-deel", "arq-assets"],
      "conditions": "El escenario conserva la etiqueta USDc guardada. ARQ informa una migración a USDs; confirmá el activo acreditado y su conversión. No incluye un retiro cripto externo en USDC."
    },
    {
      "id": "arq-reception",
      "label": "Recepción en ARQ",
      "inputCurrency": "USDc",
      "outputCurrency": "USDc",
      "fee": { "fixed": 3 },
      "feeStatus": "official",
      "sourceIds": ["arq-deel"],
      "conditions": "Tarifa estándar en USDc. Revisá las transferencias incluidas y beneficios de tu plan; reemplazá el cargo si corresponde."
    },
    {
      "id": "deel-pix",
      "label": "Cambio USD a BRL por Pix",
      "inputCurrency": "USD",
      "outputCurrency": "BRL",
      "fee": { "fixed": 0 },
      "feeStatus": "included-in-rate",
      "sourceIds": ["deel-pix"],
      "conditions": "Sin cargo del proveedor por Pix; usá un cambio final que incluya los costos de conversión. Requiere residencia fiscal o domicilio en Brasil y una cuenta Pix propia."
    },
    {
      "id": "deel-breb-fee",
      "label": "Deel a Bre-B · conversión",
      "inputCurrency": "USD",
      "outputCurrency": "USD",
      "fee": { "percent": 1.5, "fixed": 3 },
      "feeStatus": "official",
      "minimumAmount": 5,
      "sourceIds": ["deel-breb"],
      "conditions": "Tarifa para USD a COP. Llave Bre-B propia y datos de identidad coincidentes."
    },
    {
      "id": "usd-cop",
      "label": "Cambio a pesos colombianos",
      "inputCurrency": "USD",
      "outputCurrency": "COP",
      "fee": { "fixed": 0 },
      "feeStatus": "included-in-rate",
      "maximumOutput": 11500000,
      "sourceIds": ["deel-breb"],
      "conditions": "Cotización final sin descontar nuevamente el 1,5% + USD 3 mostrado arriba. Hay límites adicionales según cuenta."
    },
    {
      "id": "breb-reception",
      "label": "Banco o billetera receptora",
      "inputCurrency": "COP",
      "outputCurrency": "COP",
      "fee": null,
      "feeStatus": "pending",
      "sourceIds": ["deel-breb"],
      "conditions": "La entidad receptora puede cobrar. Confirmá su cargo o indicá cero si no aplica."
    }
  ],
